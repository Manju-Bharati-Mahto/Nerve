# Test database configuration. Read ONLY by the test suite, through
# server/test-db.ts — the application never loads this file.
#
# `npm run test:db:setup` creates the database and writes a real .env.test
# for you, deriving the host and credentials from .env.local. Copy this file
# by hand only if you want a different target.
#
# The database name MUST contain "test": server/test-db.ts refuses anything
# else rather than silently redirecting it.
DATABASE_URL=postgres://nerve_app:CHANGE_ME@127.0.0.1:5432/nerve_test
SESSION_SECRET=integration-test-secret
SUPER_ADMIN_PASSWORD=integration-test-password
