APP_BASE_URL=http://your-server-ip
API_PORT=3001
VITE_API_BASE_URL=/api
COOKIE_SECURE=false
SESSION_SECRET=replace-with-a-long-random-string
DATABASE_URL=postgres://nerve_app:replace-with-db-password@db:5432/nerve
POSTGRES_DB=nerve
POSTGRES_USER=nerve_app
POSTGRES_PASSWORD=replace-with-db-password
POSTGRES_DATA_DIR=/srv/nerve/data/postgres
SUPER_ADMIN_EMAIL=super@parul.ac.in
SUPER_ADMIN_PASSWORD=replace-with-random-bootstrap-password
# Google Identity Services client id for the public casting/request portals.
# Client type "Web application"; authorized JavaScript origin is the site origin
# (e.g. https://nerve.paruluniversity.ac.in). No redirect URI and no client
# secret: the portals verify the ID token server-side. Left empty, they refuse
# external submissions rather than accept an unverified identity.
GOOGLE_OAUTH_CLIENT_ID=
