APP_BASE_URL=http://your-server-ip
API_PORT=3001
VITE_API_BASE_URL=/api
COOKIE_SECURE=false
SESSION_SECRET=replace-with-a-long-random-string
DATABASE_URL=postgres://nerve_app:replace-with-db-password@db:5432/nerve
POSTGRES_DB=nerve
POSTGRES_USER=nerve_app
POSTGRES_PASSWORD=replace-with-db-password
POSTGRES_DATA_DIR=/srv/nerve/data/postgres
SUPER_ADMIN_EMAIL=super@parul.ac.in
SUPER_ADMIN_PASSWORD=replace-with-random-bootstrap-password

# ── AI provider (optional) ────────────────────────────────────────────────────
# Leave AI_API_KEY empty to keep the AI layer switched off. Nerve runs normally
# with none of these set. AI_API_KEY is SERVER-ONLY — never give it a VITE_
# prefix, which would inline it into the browser bundle.
# AI_BASE_URL must be https for any remote host; plain http is accepted only for
# a loopback address (a model running on this machine).
# Production is OpenAI:
#   AI_PROVIDER=openai
#   AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL has no default — set the exact model id, or AI stays disabled.
AI_PROVIDER=openai
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Per-user requests per Nerve calendar day.
AI_DAILY_REQUEST_LIMIT=50
# Optional per-model rates from your own billing page. Unset = cost not estimated.
AI_PRICING=

# ── Google Drive: Outreach video workflow storage ──────────────────────────
# Drive is the storage AND live data source for the video workflow (PRD §6/§28)
# — there are no Postgres tables behind it. With nothing set here, the video
# workflow reports itself unconfigured and the rest of Nerve is unaffected.
#
# The "Agency Video Workflow" folder id. The store creates Videos/, Thumbnails/
# and Reports/ plus the three JSON data stores beneath it on first use.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
#
# Auth — configure ONE of the two shapes below.
#
# 1. Service account (preferred). It has no Drive storage quota of its own, so
#    the root folder above must live in a SHARED DRIVE that this account has
#    Content-manager access to. Paste the private key with literal \n escapes.
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
#
# 2. OAuth refresh token — acts as one agency Google account. Works with an
#    ordinary My Drive folder, no Shared Drive needed.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
#
# ── Google Drive: casting registration photos ──────────────────────────────
# Applicants upload a photo on the public casting form; Nerve puts it in a
# Drive folder, under a sub-folder named after the request (CR-00012/).
# The usual way to set this up is IN THE APP: an Admin opens Casting
# Management → Google Drive, signs in with Google, and Nerve creates the
# folder. That needs only GOOGLE_OAUTH_CLIENT_ID / _SECRET above (or the same
# pasted into the dialog) and an https APP_BASE_URL for Google's redirect.
# This variable is the environment-only alternative: a folder id, used with the
# credentials above. An app connection takes precedence over it. Leave both
# unset and the form asks for a Drive link instead, as it did before.
GOOGLE_DRIVE_CASTING_FOLDER_ID=
#
# Dev/test only: run the workflow against a local directory using an adapter
# with identical semantics (same JSON layout, same revision guards). Ignored
# whenever real Google credentials are present, so it cannot shadow production.
DRIVE_LOCAL_ROOT=
